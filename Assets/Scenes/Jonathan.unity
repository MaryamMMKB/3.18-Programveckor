  m_Script: {fileID: 11500000, guid: 8f6425cc87f7a554b942fb763f8b259d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryInteractable
  manager: {fileID: 2076006636}
  shortComment: 
  diaryEntry: "Dear Diary,\r\nI have been much occupied this day with an uncommon
    degree of labour. I paid a visit of some note to the Edmund household in Grasmere,
    whose present circumstances, though respectable, are not without difficulty.
    The call was met with gratitude, and I trust my presence afforded them some comfort,
    for our families have long shared a close and amiable connection. From there,
    we travelled eastward toward Ambleside, where I resolved to distribute charity
    among the poor. Given the privileges of my rank, I believe such acts not only
    proper but necessary\u2014unlike the cold obstinacy shown by many men who presume
    themselves fit to rule this country."
  alreadyReadComment: I've already looked at this.
  sequenceManager: {fileID: 0}
  advanceDelay: 2
  blockingCollider: {fileID: 0}
