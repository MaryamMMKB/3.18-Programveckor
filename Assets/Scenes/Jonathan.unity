  m_EditorClassIdentifier: Assembly-CSharp::DiaryInteractable
  manager: {fileID: 1238563033}
  shortComment: Is this not...
  diaryEntry: "I have found Mr. Kalahan\u2019s watch and walking cane sunk into the
    mud. My gown is now quite ruined, and if this is intended as amusement, I find
    no pleasure in it whatsoever. I had resolved to return to the carriage and wait,
    yet something within me urges me onward, as though he wishes me to follow him
    still."
  alreadyReadComment: I've already looked at this.
  sequenceManager: {fileID: 1558855496}
  advanceDelay: 4
  blockingCollider: {fileID: 864374955}
