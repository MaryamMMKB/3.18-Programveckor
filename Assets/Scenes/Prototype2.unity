  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryInteractable
  manager: {fileID: 1864230972}
  shortComment: "What is this\u2026?"
  diaryEntry: "His conduct is entirely unlike him, for he has ever been steady and
    obedient in his duties. I must determine whether he has come to harm. Perhaps
    the horse fled and he pursued it into the woods\u2014but such a notion cannot
    account for the scraps of fabric and\u2026 skin\u2026 I have found upon the ground.
    A wolf, perhaps. A rogue beast. I cannot say, yet I shall continue my inquiry."
  alreadyReadComment: I've already looked at this.
  sequenceManager: {fileID: 1940110987}
  advanceDelay: 4
  blockingCollider: {fileID: 0}
