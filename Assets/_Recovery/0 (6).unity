  m_Script: {fileID: 11500000, guid: 32e9a156235843a46be2889b35c0a9af, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeTrigger
  opensDiary: 1
  diaryEntry: "I have been much occupied this day with an uncommon degree of labour.
    I paid a visit of some note to the Edmund household in Grasmere, whose present
    circumstances, though respectable, are not without difficulty. The call was met
    with gratitude, and I trust my presence afforded them some comfort, for our families
    have long shared a close and amiable connection. From there, we travelled eastward
    toward Ambleside, where I resolved to distribute charity among the poor. Given
    the privileges of my rank, I believe such acts not only proper but necessary\u2014unlike
    the cold obstinacy shown by many men who presume themselves fit to rule this
    country."
  dialogText: 
  dialogDuration: 2.5
  blockBacktracking: 0
  blockerPrefab: {fileID: 0}
  hasTriggered: 0
